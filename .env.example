# Copy to `.env.local` for local development. Everything here is optional:
# the site builds and runs with the defaults in `lib/site.ts`.

# ── Site ────────────────────────────────────────────────────────────────────
# Canonical public URL (sitemap, canonical links, Open Graph).
NEXT_PUBLIC_SITE_URL=https://www.resenyconnect.com

# Live-demo iframe used in the hero and on /get-a-call.
# Defaults to the embed supplied for the project.
# NEXT_PUBLIC_DEMO_EMBED_URL=https://resenyai.com/embed/demo?token=...

# ── Lead capture (server-only, never exposed to the browser) ────────────────
# Every form (book a demo, get a call, pilot, contact, newsletter) POSTs its
# validated payload as JSON to this URL: point it at your CRM, Zapier/Make/n8n
# hook, or the Reseny platform's lead-intake endpoint.
# In production the forms report an error if this is not set; in development
# leads are logged to the server console instead.
LEADS_WEBHOOK_URL=
# Optional shared secret, sent as `Authorization: Bearer <secret>`.
LEADS_WEBHOOK_SECRET=

# ── Contact details (shown only when set) ───────────────────────────────────
NEXT_PUBLIC_CONTACT_EMAIL_SALES=
NEXT_PUBLIC_CONTACT_EMAIL_SUPPORT=
NEXT_PUBLIC_CONTACT_EMAIL_PARTNERS=
NEXT_PUBLIC_CONTACT_PHONE=
# WhatsApp number in international format, digits only (e.g. 919876543210).
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_CONTACT_ADDRESS=
# Google Maps embed URL for the contact page (optional).
NEXT_PUBLIC_CONTACT_MAP_EMBED_URL=

# ── Links (shown only when set) ─────────────────────────────────────────────
# Where "Log in" points (the Reseny Connect dashboard).
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_STATUS_URL=
NEXT_PUBLIC_HELP_CENTER_URL=
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_YOUTUBE=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=
NEXT_PUBLIC_SOCIAL_FACEBOOK=

# ── Analytics (optional) ────────────────────────────────────────────────────
# Google Tag Manager container. Conversion events are pushed to `dataLayer`
# (see lib/analytics.ts) so GA4, Meta, LinkedIn etc. can be wired in GTM.
NEXT_PUBLIC_GTM_ID=
